{
  "schema_version": "0.1",
  "name": "Meshfleet stdio catalog-boundary conformance v0.1",
  "scope": "bounded stdio catalog boundary only; not multi-client or full A2A conformance",
  "server_entrypoint": "dist/index.js",
  "expected_catalog_sha256": "4d0289400e23c57b1e43347eb9d8f9258decf7b824516e0d066380d7e6f88fa8",
  "unknown_tool_expectation": {
    "name": "__meshfleet_catalog_boundary_unknown_tool__",
    "expected_exception_code": -32603,
    "expected_message_substring": "Unknown tool: __meshfleet_catalog_boundary_unknown_tool__"
  },
  "synthetic_profiles": [
    "synthetic-profile-01",
    "synthetic-profile-02"
  ],
  "families": {
    "lifecycle": {
      "tools": [
        { "name": "spawn_fleet", "advertised_input_schema_members": ["agents"] },
        { "name": "fleet_status", "advertised_input_schema_members": ["fleet_id"] },
        { "name": "list_fleets", "advertised_input_schema_members": [] },
        { "name": "set_fleet_timeout", "advertised_input_schema_members": ["fleet_id", "timeout_ms"] },
        { "name": "collect_results", "advertised_input_schema_members": ["fleet_id"] },
        { "name": "list_agents", "advertised_input_schema_members": [] },
        { "name": "attach_agent", "advertised_input_schema_members": ["fleet_id", "role", "prompt", "agent"] }
      ]
    },
    "messaging": {
      "tools": [
        { "name": "send_message", "advertised_input_schema_members": ["fleet_id", "from_agent_id", "to_agent_id", "type", "payload", "correlation_id"] },
        { "name": "send_messages", "advertised_input_schema_members": ["messages"] }
      ]
    },
    "inbox": {
      "tools": [
        { "name": "get_inbox", "advertised_input_schema_members": ["agent_id", "since"] },
        { "name": "ack_message", "advertised_input_schema_members": ["agent_id", "message_id"] },
        { "name": "subscribe_inbox", "advertised_input_schema_members": ["agent_id"] }
      ]
    },
    "receipts": {
      "tools": [
        { "name": "receipt", "advertised_input_schema_members": ["agent_id", "message_id", "action", "note"] },
        { "name": "get_receipts", "advertised_input_schema_members": ["message_id"] },
        { "name": "verify_ledger", "advertised_input_schema_members": [] }
      ]
    },
    "ratification": {
      "tools": [
        { "name": "open_ratification", "advertised_input_schema_members": ["proposer", "fleet_id", "subject", "payload", "quorum", "voters", "required_signoffs", "deadline", "silence_policy", "weights"] },
        { "name": "cast_vote", "advertised_input_schema_members": ["agent_id", "message_id", "approve", "note"] },
        { "name": "tally_ratification", "advertised_input_schema_members": ["message_id"] },
        { "name": "sweep_ratifications", "advertised_input_schema_members": [] }
      ]
    },
    "capability-routing": {
      "tools": [
        { "name": "register_capability", "advertised_input_schema_members": ["agent_id", "fleet_id", "role", "skills", "model", "context_window"] },
        { "name": "route_work", "advertised_input_schema_members": ["description", "top_n"] },
        { "name": "record_routing_outcome", "advertised_input_schema_members": ["agent_id", "capability_key", "success"] }
      ]
    },
    "health": {
      "tools": [
        { "name": "ping", "advertised_input_schema_members": [] },
        { "name": "get_health", "advertised_input_schema_members": [] }
      ]
    }
  },
  "stable_call_invariants": {
    "ping": {
      "expected": { "status": "ok" },
      "ignored_volatile_fields_when_present": ["timestamp"]
    },
    "get_health": {
      "expected": {
        "status": "ok",
        "fleets": 0,
        "agents": 0,
        "messages": 0,
        "capabilities": 0,
        "events": 0
      },
      "ignored_volatile_fields_when_present": ["uptime_ms", "ledger_bytes", "events_log_bytes", "last_event_timestamp", "abandoned_fleets"]
    }
  }
}
